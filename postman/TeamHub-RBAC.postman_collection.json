              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": "pm.test(\"201 response\", () => { pm.response.to.have.status(201); });\npm.test(\"Public registration always creates a member without returning a password\", () => { const body=pm.response.json(); pm.expect(body.data.user.role).to.eql('member'); pm.expect(body.data.user).not.to.have.property('password'); pm.collectionVariables.set('memberId',String(body.data.user.id)); });"
