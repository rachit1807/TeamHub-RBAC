PORT=8000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
DB_STORAGE=database.sqlite
# Optional hosted database. Set DATABASE_URL to use PostgreSQL instead of SQLite.
# DATABASE_URL=postgres://user:password@host:5432/database
# DATABASE_SSL=true
CORS_ORIGIN=http://localhost:8000,http://127.0.0.1:8000
# Optional: set these then run npm run seed:admin to create the first administrator.
SEED_ADMIN_NAME=TeamHub Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=use-a-unique-password-at-least-12-characters
